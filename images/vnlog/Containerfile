# vnlog: the vnl-* tools, the C library and the perl modules, in a slim runtime
# image. calibration-base builds and tests vnlog; this copies its install tree.
# The Python module is left out, since the image has no python3; the mrgingham
# and mrcal images have it.
#
# Build context: vnlog (see scripts/build-image), for the image's version and
# labels; the source itself comes from calibration-base

ARG DEBIAN_IMAGE
ARG PREFIX

FROM ${PREFIX}calibration-base AS base

######################################## runtime
FROM ${DEBIAN_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=bind,from=base,source=/stage/vnlog-runtime-packages.txt,target=/tmp/vnlog-runtime-packages.txt \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends $(cat /tmp/vnlog-runtime-packages.txt)

COPY --from=base /stage/vnlog/usr /usr

# Fail the build if any tool is missing a runtime dependency
RUN for t in /usr/bin/vnl-*; do perl -c "$t" || exit 1; done

WORKDIR /data
CMD ["vnl-filter", "--help"]
