# Build environment shared by the other images: Debian's toolchain, plus mrbuild,
# libdogleg and vnlog built (and tested) from the pinned sources. Debian's own
# packages of these are older than the pins; building vnlog here means every
# build stage tests against the pinned vnlog too. dogleg.h goes in
# /usr/include, where mrcal looks for it and Debian's libdogleg-dev puts it.
#
# Build contexts: mrbuild, libdogleg, vnlog (see scripts/build-image)
#
# Only used as a build stage, never shipped. Each library's install tree is
# also kept in /stage/NAME for the runtime images to copy: /stage/libdogleg,
# /stage/vnlog (with vnlog-runtime-packages.txt, the Debian packages it needs)
# and /stage/vnlog-python, vnlog's Python module, kept apart for the images
# that have python3.

ARG DEBIAN_IMAGE
FROM ${DEBIAN_IMAGE}
ARG DEBIAN_FRONTEND=noninteractive

# python3-setuptools: mrbuild finds the python module path via distutils, which
# python 3.12+ no longer has. zsh runs the test suites
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential pkg-config chrpath mawk perl zsh \
        python3-dev python3-numpy python3-setuptools \
        libsuitesparse-dev liblapack-dev \
        moreutils libipc-run-perl libtext-diff-perl libstring-shellquote-perl \
        liblist-moreutils-perl libtext-table-perl

# mrbuild is a set of Makefile fragments and helper scripts. These are the
# paths choose_mrbuild.mk looks for, as Debian's mrbuild package installs them
COPY --from=mrbuild Makefile.common.header Makefile.common.footer /usr/include/mrbuild/
COPY --from=mrbuild bin/ /usr/bin/

ARG VERSION_libdogleg
WORKDIR /src/libdogleg
COPY --from=libdogleg . .
RUN make -j"$(nproc)" VERSION="$VERSION_libdogleg" \
    && make check VERSION="$VERSION_libdogleg" \
    && make install VERSION="$VERSION_libdogleg" DESTDIR=/stage/libdogleg \
        INSTALL_ROOT_INCLUDE=/usr/include \
    && cp -a /stage/libdogleg/. / \
    && ldconfig

ARG VERSION_vnlog
WORKDIR /src/vnlog
COPY --from=vnlog . .
RUN make -j"$(nproc)" VERSION="$VERSION_vnlog" all doc \
    && make -j"$(nproc)" VERSION="$VERSION_vnlog" check \
    && make VERSION="$VERSION_vnlog" install DESTDIR=/stage/vnlog \
    && mkdir -p /stage/vnlog/usr/share/zsh/site-functions \
                /stage/vnlog/usr/share/bash-completion/completions \
                /stage/vnlog/usr/share/calibration-containers \
                /stage/vnlog/usr/share/doc/vnlog \
                /stage/vnlog-python/usr/lib \
    && cp completions/zsh/*  /stage/vnlog/usr/share/zsh/site-functions/ \
    && cp completions/bash/* /stage/vnlog/usr/share/bash-completion/completions/ \
    && ls /stage/vnlog/usr/bin > /stage/vnlog/usr/share/calibration-containers/vnlog.tools \
    && find . -maxdepth 1 \( -name 'README*' -o -name 'LICENSE*' \) \
            -exec cp -t /stage/vnlog/usr/share/doc/vnlog {} + \
    && mv /stage/vnlog/usr/lib/python3 /stage/vnlog-python/usr/lib/ \
    && echo mawk moreutils perl \
            liblist-moreutils-perl libtext-table-perl libstring-shellquote-perl \
            > /stage/vnlog-runtime-packages.txt \
    && cp -a /stage/vnlog/. /stage/vnlog-python/. / \
    && ldconfig

WORKDIR /
